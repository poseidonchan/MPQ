+@dataclass
+class MPGQConfig:
+    """MPGQ exact-full VAMP + greedy polish (research path).
+
+    This is a dense quantization path that can optionally use an internal right-side
+    Hadamard rotation for preconditioning. When that internal rotation is enabled
+    (`rotation='hadamard'`), the result is intended for dense evaluation and is not
+    packed/exported as a GPTQ checkpoint.
+    """
+
+    enabled: bool = False
+
+    # VAMP loop
+    iters: int = 10
+    damping: float = 0.5
+    x1_mode: str = "mmse"  # "mmse" | "map"
+    final_decision: str = "map"
+    gamma_start: float = 1.0
+    gamma_retry_factor: float = 4.0
+    gamma_retry_steps: int = 3
+    prior_tau: float = 0.2
+
+    # Linear module / likelihood
+    obs_precision: float = 0.0  # <=0 means warm start
+    em_obs_precision: bool = True
+    em_obs_precision_damping: float = 0.3
+    em_obs_precision_min: float = 1e-4
+    em_obs_precision_max: float = 1e8
+
+    # Adaptive accept/reject
+    best_iterate_export: bool = True
+    adaptive_accept_reject: bool = True
+    adaptive_retry_steps: int = 3
+    adaptive_accept_tol: float = 1e-4
+    adaptive_damping_min: float = 0.1
+    adaptive_obs_precision_backoff: float = 0.5
+
+    # Greedy polish
+    polish_sweeps: int = 3
+
+    # Full-layer driver
+    block_rows: int = 32
+
+    # GPTQModel upstream stores H = 2/m X^T X. Set to 0.5 to match X^T X / m.
+    hessian_scale: float = 0.5
+    eigen_jitter: float = 1e-6
+    eigen_floor_scale: float = 1e-6
+    rotation_seed: int = 0
+
+
 @dataclass
 class GPTAQConfig:
     alpha: float = field(default=0.25)
