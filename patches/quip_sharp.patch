+def _iter_text_rows(dataset_name: str, split: str, seed: int):
+    dataset_name = str(dataset_name)
+    split = str(split)
+    seed = int(seed)
+
+    if dataset_name == 'c4':
+        dataset = load_dataset('allenai/c4', 'en', split=split, streaming=True)
+        buffer_size = max(8192, min(65536, 64 * 128))
+        dataset = dataset.shuffle(seed=seed, buffer_size=buffer_size)
+        for row in dataset:
+            text = row.get('text')
+            if isinstance(text, str) and text.strip():
+                yield text
+        return
+
+    if dataset_name in ('wikitext2', 'wikitext-2-raw-v1'):
+        dataset = load_dataset('wikitext', 'wikitext-2-raw-v1', split=split).shuffle(seed=seed)
+        for row in dataset:
+            text = row.get('text')
+            if isinstance(text, str) and text.strip():
+                yield text
+        return
+
+    raise ValueError(f"unsupported dataset_name={dataset_name!r}; expected one of {{'c4','wikitext2','rp1t'}}")
+
+
+def sample_token_blocks(tokenizer, dataset_name='c4', split='train', size=128, ctx_size=2048, nproc=1, seed=0):
+    dataset_name = str(dataset_name)
+    if dataset_name == 'rp1t':
+        return sample_rp1t(tokenizer, size=size, ctx_size=ctx_size, nproc=nproc)
+
+    rng = random.Random(int(seed))
+    devset = torch.zeros((int(size), int(ctx_size)), dtype=torch.int64)
+    saved = 0
+    rows_seen = 0
+    for text in _iter_text_rows(dataset_name, split, int(seed)):
+        rows_seen += 1
+        token_ids = tokenizer(
+            text,
+            add_special_tokens=False,
+            return_attention_mask=False,
+            truncation=False,
+        )['input_ids']
+        if len(token_ids) < int(ctx_size):
+            continue
+
+        start = 0 if len(token_ids) == int(ctx_size) else rng.randint(0, len(token_ids) - int(ctx_size))
+        devset[saved] = torch.tensor(token_ids[start:start + int(ctx_size)], dtype=torch.int64)
+        saved += 1
+        if saved >= int(size):
+            break
+
+    if saved < int(size):
+        raise RuntimeError(
+            f"Unable to build {int(size)} token blocks of length {int(ctx_size)} from `{dataset_name}` `{split}`. "
+            f"Only collected {saved} after scanning {rows_seen} rows."
+        )
+
+    return devset
+
