+def _hadamard_transform_torch(x: torch.Tensor, scale: float) -> torch.Tensor:
+    n = x.shape[-1]
+    assert is_pow2(n), f"Hadamard dim must be power-of-two; got {n}"
+
+    shape = x.shape
+    input = x.contiguous().view(-1, n, 1)
+    output = input.clone()
+    while input.shape[1] > 1:
+        input = input.view(input.shape[0], input.shape[1] // 2, 2,
+                           input.shape[2])
+        output = output.view(input.shape)
+        output[:, :, 0, :] = input[:, :, 0, :] + input[:, :, 1, :]
+        output[:, :, 1, :] = input[:, :, 0, :] - input[:, :, 1, :]
+        output = output.view(input.shape[0], input.shape[1], -1)
+        (input, output) = (output, input)
+    del output
+    utils.clean()
+    return input.view(shape) * scale
+
+
+def _is_fast_hadamard_unsupported(exc: RuntimeError) -> bool:
+    msg = str(exc).lower()
+    needles = (
+        "no kernel image is available",
+        "invalid device function",
+        "not compiled",
+    )
+    return any(needle in msg for needle in needles)
+
+
+def hadamard_fallback(x: torch.Tensor, scale: float) -> torch.Tensor:
+    global _warned_fast_hadamard_fallback, _disable_fast_hadamard_transform
+    if fast_hadamard_transform is None or _disable_fast_hadamard_transform:
+        return _hadamard_transform_torch(x, scale)
+
+    try:
+        return fast_hadamard_transform.hadamard_transform(x, scale)
+    except RuntimeError as exc:
+        if not _is_fast_hadamard_unsupported(exc):
+            raise
+        _disable_fast_hadamard_transform = True
+        if not _warned_fast_hadamard_fallback:
+            cap_str = "unknown"
+            if x.is_cuda:
+                cap = torch.cuda.get_device_capability(x.device)
+                cap_str = f"{cap[0]}.{cap[1]}"
+            print(f"[quip-sharp] fast_hadamard_transform failed on SM {cap_str}; using torch fallback.", flush=True)
+            _warned_fast_hadamard_fallback = True
+        return _hadamard_transform_torch(x, scale)
 
 
